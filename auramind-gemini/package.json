{
  "name": "auramind",
  "private": true,
  "version": "2.0.0",
  "description": "AuraMind — adaptive AI learning system (React app, PWA, and Capacitor Android).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host --port 3001",
    "build": "vite build",
    "size": "npm run build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npx vercel --prod --archive=tgz",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "analyze": "npx vite-bundle-visualizer",
    "migrate": "node ../run-migrations.js",
    "migrate:dry": "node ../run-migrations.js --dry-run",
    "migrate:status": "node scripts/migrate-status.cjs",
    "diagnostics": "node scripts/check-migration-drift.cjs && node scripts/check-remote-drift.cjs",
    "diagnostics:drift": "node scripts/check-migration-drift.cjs",
    "diagnostics:remote": "node scripts/check-remote-drift.cjs",
    "env:check": "node -e \"const e=require('./src/lib/env.ts');console.log('env:check stub — see src/lib/env.ts validateEnv()')\"",
    "build:android": "vite build --mode mobile && npx cap sync android",
    "build:apk:debug": "vite build --mode mobile && npx cap sync android && node scripts/build-debug-apk.mjs",
    "build:aab:release": "vite build --mode mobile && npx cap sync android && node scripts/run-gradle.mjs bundleRelease",
    "cap:sync": "npx cap sync android"
  },
