# Windows app build environment overrides (committed — contains NO secrets).
#
# Vite merges .env (gitignored, supplies SUPABASE_URL/ANON_KEY) with this file
# when building with `--mode desktop` (npm run build:desktop). The Tauri
# window serves the bundled app from https://tauri.localhost, which has no
# API of its own, so every API base points at production — same as the
# Android build's .env.mobile.
#
# Turnstile is switched off at runtime in the app (Cloudflare cannot issue
# tokens to the app's origin), so it signs in with email + password like the
# phone apps — see isAppShell in src/lib/platform.ts.

VITE_API_BASE_URL=https://auramind.app
VITE_SSE_BASE=https://auramind.app
VITE_TRANSLATION_API_URL=https://auramind.app
VITE_APP_URL=https://auramind.app
VITE_USE_PUTER=true
